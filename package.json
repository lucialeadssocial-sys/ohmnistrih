{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "verify:academy": "tsx verify_academy.mjs",
    "verify:director": "tsx verify_director_fixes.ts",
    "verify:director-mode": "tsx verify_director_mode.ts",
    "verify:director-ui": "tsx verify_director_ui.mjs",
    "verify:shorts": "tsx verify_shorts.ts",
    "verify:reframe": "tsx verify_reframe.ts",
    "verify:media-link": "tsx verify_media_link.ts",
    "verify:captions": "tsx verify_captions.ts",
    "verify:qc": "tsx verify_qc.ts",
    "verify:app": "tsx smoke.mjs",
    "verify:boundary": "tsx verify_errorboundary.mjs",
    "verify:multicam": "tsx verify_2s.ts",
    "verify:acceptance": "tsx acceptance_2s.ts",
    "verify:fixes": "tsx verify_fixes.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@huggingface/transformers": "^4.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsdom": "^30.1.1",
    "lucide-react": "^0.546.0",
    "mediabunny": "^1.59.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "jsdom": "^30.1.1"
  }
}
